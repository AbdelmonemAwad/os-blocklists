<model>
    <mount>//OPNsense/BlockLists</mount>
    <version>1.0.0</version>
    <description>Block lists</description>
    <items>
        <!--
            plugins.inc.d/blocklists.inc, cut.py and ja4_cut.py read these straight out of config.xml
            by element name, so the names are not free.
        -->
        <general>
            <enabled type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </enabled>
            <!-- the ids of scripts/blocklists/feeds.json; a feed added there is added here too - but for
                 one filled by the plugin itself ("local", the IPS drops), which has a setting of its own -->
            <feeds type="OptionField">
                <Multiple>Y</Multiple>
                <Required>N</Required>
                <OptionValues>
                    <spamhaus_drop>Spamhaus DROP (IPv4)</spamhaus_drop>
                    <spamhaus_dropv6>Spamhaus DROP (IPv6)</spamhaus_dropv6>
                    <feodo>abuse.ch Feodo Tracker</feodo>
                    <threatfox>ThreatFox: command-and-control addresses</threatfox>
                    <et_compromised>Emerging Threats compromised hosts</et_compromised>
                    <cins_army>CINS Army</cins_army>
                    <blocklist_de>blocklist.de (all)</blocklist_de>
                </OptionValues>
            </feeds>
            <!--
                The owner's abuse.ch Auth-Key, for ThreatFox (2026-11-17): scripts/blocklists/threatfox.py
                sends it to abuse.ch in the address of each export, as abuse.ch asks. An UpdateOnlyTextField,
                OPNsense's write-only field: the settings' answer to the page has it empty, and an empty
                value from the form keeps the key saved; the Settings tab's Remove the key takes it out
                (Api/SettingsController.php, forgetKeyAction()). PHP reads it with getValue() - (string)
                of such a field is always "". Only the characters an address carries as they are (RFC
                3986's unreserved), and nothing after them (D: not a newline either), so it can never
                change the path it is put in; threatfox.py checks the same.
            -->
            <threatfox_key type="UpdateOnlyTextField">
                <Required>N</Required>
                <Mask>/^[A-Za-z0-9._~-]{8,128}$/D</Mask>
                <ValidationMessage>An abuse.ch Auth-Key is 8 to 128 letters and digits, and may have . _ ~ or -.</ValidationMessage>
            </threatfox_key>
            <!--
                How often each feed's alias is fetched again (scripts/blocklists/updatefreq.php): the
                longer of this and the feed's own minimum in feeds.json. The keys are read there.
            -->
            <refresh type="OptionField">
                <Required>Y</Required>
                <Default>h2</Default>
                <OptionValues>
                    <h2>Every 2 hours</h2>
                    <h6>Every 6 hours</h6>
                    <h12>Every 12 hours</h12>
                    <h24>Once a day</h24>
                </OptionValues>
            </refresh>
            <countries type="CountryField">
                <Multiple>Y</Multiple>
                <Required>N</Required>
            </countries>
            <direction type="OptionField">
                <Required>Y</Required>
                <Default>both</Default>
                <OptionValues>
                    <in>Inbound only</in>
                    <both>Both ways</both>
                </OptionValues>
            </direction>
            <log type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </log>
            <cut type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </cut>
            <!--
                TLS over TCP fingerprints (t...) only, each set apart by a comma or a space: ja4_cut.py
                reads the IDS's tls lines, where a QUIC (q) or DTLS (d) client's fingerprint is not, and
                until 2026-10-29 one of those was taken here and never matched - as were two fingerprints
                written together, which ja4_cut.py then refused as one. The same form as os-xgs-npu's
                cut_ja4, t only.
            -->
            <ja4 type="TextField">
                <Required>N</Required>
                <Mask>/^[\s,]*(t[0-9a-z]{2}[di][0-9]{4}[0-9A-Za-z]{2}_[0-9a-f]{12}_[0-9a-f]{12}([\s,]+t[0-9a-z]{2}[di][0-9]{4}[0-9A-Za-z]{2}_[0-9a-f]{12}_[0-9a-f]{12})*)?[\s,]*$/</Mask>
                <ValidationMessage>Each fingerprint looks like t13d1516h2_8daaf6152771_02713d6af862, separated by commas.</ValidationMessage>
            </ja4>
            <!--
                What the Intrusion Detection's IPS policy drops, blocked and cut for a while (ff-10,
                2026-11-19): scripts/blocklists/ids_list.py reads these by element name. Off by default; an
                address kept so many minutes after its last drop; with outside on (the default) never a
                private one. All three have defaults, so nothing is migrated.
            -->
            <ids type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </ids>
            <ids_minutes type="IntegerField">
                <Required>Y</Required>
                <Default>60</Default>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>10080</MaximumValue>
                <ValidationMessage>Keep an address from 5 minutes to 10080 (a week).</ValidationMessage>
            </ids_minutes>
            <ids_outside type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </ids_outside>
            <!--
                The owner's own exceptions to what the IPS drops (2026-11-19 review): addresses and networks
                never entered. Each checked again by ids_list.py, which leaves out what is not one.
            -->
            <ids_never type="CSVListField">
                <Required>N</Required>
                <Mask>/\A[0-9A-Fa-f:.]{2,45}(\/[0-9]{1,3})?\z/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Each is an address or a network, such as 198.51.100.7, 198.51.100.0/24 or 2001:db8::/48.</ValidationMessage>
            </ids_never>
            <!--
                UT1's web categories chosen (2026-11-19), applied through OPNsense's own Unbound blocklist by
                scripts/blocklists/categories.py and the handler scripts/unbound/blocklists/blocklists_ut1.py.
                CategoryField offers the categories of scripts/blocklists/categories.json and those UT1's own
                catalogue adds where categories.py fetched it - never adult (decision d2). categories.py
                reads this by element name, and refuses adult and any name no catalogue has, whatever is
                written here. Empty by default: nothing to migrate.
            -->
            <categories type="OPNsense\BlockLists\FieldTypes\CategoryField">
                <Multiple>Y</Multiple>
                <Required>N</Required>
            </categories>
            <!--
                Names the web categories let through, each with every subdomain: the handler writes
                (.*\.)?name$ for each into its policy's passlist. That policy's only, as OPNsense's own
                allowlists apply to their own policy only.
            -->
            <exceptions type="CSVListField">
                <Required>N</Required>
                <Mask>/\A(?=.{1,253}\z)(?:[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\.)+[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\z/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>An exception is a name such as example.com: letters, digits, hyphens and dots.</ValidationMessage>
            </exceptions>
        </general>
    </items>
</model>
