<model>
    <mount>//OPNsense/BlockLists</mount>
    <version>1.0.0</version>
    <description>Block lists</description>
    <items>
        <!--
            plugins.inc.d/blocklists.inc, cut.py and ja4_cut.py read these straight out of config.xml
            by element name, so the names are not free.
        -->
        <general>
            <enabled type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </enabled>
            <!-- the ids of scripts/blocklists/feeds.json; a feed added there is added here too -->
            <feeds type="OptionField">
                <Multiple>Y</Multiple>
                <Required>N</Required>
                <OptionValues>
                    <spamhaus_drop>Spamhaus DROP (IPv4)</spamhaus_drop>
                    <spamhaus_dropv6>Spamhaus DROP (IPv6)</spamhaus_dropv6>
                    <feodo>abuse.ch Feodo Tracker</feodo>
                    <threatfox>ThreatFox: command-and-control addresses</threatfox>
                    <et_compromised>Emerging Threats compromised hosts</et_compromised>
                    <cins_army>CINS Army</cins_army>
                    <blocklist_de>blocklist.de (all)</blocklist_de>
                </OptionValues>
            </feeds>
            <!--
                The owner's abuse.ch Auth-Key, for ThreatFox (2026-11-17): scripts/blocklists/threatfox.py
                sends it to abuse.ch in the address of each export, as abuse.ch asks. An UpdateOnlyTextField,
                OPNsense's write-only field: the settings' answer to the page has it empty, and an empty
                value from the form keeps the key saved; the Settings tab's Remove the key takes it out
                (Api/SettingsController.php, forgetKeyAction()). PHP reads it with getValue() - (string)
                of such a field is always "". Only the characters an address carries as they are (RFC
                3986's unreserved), and nothing after them (D: not a newline either), so it can never
                change the path it is put in; threatfox.py checks the same.
            -->
            <threatfox_key type="UpdateOnlyTextField">
                <Required>N</Required>
                <Mask>/^[A-Za-z0-9._~-]{8,128}$/D</Mask>
                <ValidationMessage>An abuse.ch Auth-Key is 8 to 128 letters and digits, and may have . _ ~ or -.</ValidationMessage>
            </threatfox_key>
            <!--
                How often each feed's alias is fetched again (scripts/blocklists/updatefreq.php): the
                longer of this and the feed's own minimum in feeds.json. The keys are read there.
            -->
            <refresh type="OptionField">
                <Required>Y</Required>
                <Default>h2</Default>
                <OptionValues>
                    <h2>Every 2 hours</h2>
                    <h6>Every 6 hours</h6>
                    <h12>Every 12 hours</h12>
                    <h24>Once a day</h24>
                </OptionValues>
            </refresh>
            <countries type="CountryField">
                <Multiple>Y</Multiple>
                <Required>N</Required>
            </countries>
            <direction type="OptionField">
                <Required>Y</Required>
                <Default>both</Default>
                <OptionValues>
                    <in>Inbound only</in>
                    <both>Both ways</both>
                </OptionValues>
            </direction>
            <log type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </log>
            <cut type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </cut>
            <!--
                TLS over TCP fingerprints (t...) only, each set apart by a comma or a space: ja4_cut.py
                reads the IDS's tls lines, where a QUIC (q) or DTLS (d) client's fingerprint is not, and
                until 2026-10-29 one of those was taken here and never matched - as were two fingerprints
                written together, which ja4_cut.py then refused as one. The same form as os-xgs-npu's
                cut_ja4, t only.
            -->
            <ja4 type="TextField">
                <Required>N</Required>
                <Mask>/^[\s,]*(t[0-9a-z]{2}[di][0-9]{4}[0-9A-Za-z]{2}_[0-9a-f]{12}_[0-9a-f]{12}([\s,]+t[0-9a-z]{2}[di][0-9]{4}[0-9A-Za-z]{2}_[0-9a-f]{12}_[0-9a-f]{12})*)?[\s,]*$/</Mask>
                <ValidationMessage>Each fingerprint looks like t13d1516h2_8daaf6152771_02713d6af862, separated by commas.</ValidationMessage>
            </ja4>
        </general>
    </items>
</model>
